{
  "height": 30,
  "layer": "top",
  "position": "top",
  "rolead_style_on_change": true,
  "tray": {
    "spacing": 10
  },
  "modules-center": ["clock"],
  "modules-left": ["custom/logo", "niri/workspaces", "custom/hotkeys", "custom/nvim"],
  "custom/logo": {
    "format": "    ",
    "tooltip": true,
    "tooltip-format": "fastfetch",
    "on-click": "kitty --hold \"fastfetch\""
  },
  "custom/nvim": {
    "format": "    ",
    "tooltip": true,
    "tooltip-format": "J K L Ö     (move)\nii          (to insert mode)\nnn          (to normal mode)\nm (normal)  (to visual/select mode)\nc (visual)  (copy)\nx (visual)  (cut: copy + delete)\nctrl + z    (undo)\nctrl + y    (redo)\n:/    (search for text)\n:q          (quit without save)\n:w          (save/write)"
  },
  "custom/hotkeys": {
    "format": "    ",
    "tooltip": true,
    "tooltip-format": "MOD + 1, 2, ...   (move to workspace)\nMOD + J K L Ö     (vim move to window)\nALT + J Ö         (move windows on current workspace)\nALT + 1, 2, ...   (move window to workspace)\nMOD + D           (Applauncher)\nMOD + T           (kitty)\nMOD + V           (floating window)\nMOD +         (resize window in direction)\nPrint             (screenshot)\nCtrl + Print      (screenshot-screen)\nAlt + Print       (screenshot-window)\nCtrl + Shift + T  (kitty new tab)\nCtrl + Shift + Ö  (kitty next tab)\nCtrl + Shift + J  (kitty previous tab)\nCtrl + Shift + 󰐕  (font bigger)\nCtrl + Shift + 󰍴  (font smaller)"
  },
  "niri/workspaces": {
    "all-output": true,
    "format": "{index}"
  },
  "modules-right": [
    "group/audiogroup",
    "group/lightgroup",
    "network",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "custom/power"
  ],

  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% {icon}",
    "format-plugged": "{capacity}% {icon}",
    "format-alt": "{time} {icon}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "plugged": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    },
    "states": {
      "critical": 15,
      "warning": 30
    }
  },
  "clock": {
    "format-alt": "  {:%Y-%m-%d}  ",
    "tooltip-format": "{:%Y-%m-%d | %H:%M}"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false
  },
  "memory": {
    "format": "{}% "
  },
  "network": {
    "interval": 1,
    "format-alt": "{essid} ({signalStrength}%) 󱂇",
    "format-disconnected": "Disconnected 󱂇",
    "format-ethernet": "{essid} ({signalStrength}%) 󱂇",
    "format-linked": "{essid} ({signalStrength}%) 󱂇",
    "format-wifi": "{essid} ({signalStrength}%) 󱂇",
    "on-click": "kitty \"nmtui\""
  },
  "group/audiogroup": {
		"orientation": "horizontal",
    "click-to-reveal": true,
		"modules": [
			"pulseaudio",
			"pulseaudio/slider"
		],
    "drawer": {
      "click-to-reveal": false,
      "transition-duration": 600,
      "transition-left-to-right": true,
      "children-class": "audio_children_class"
    }
	},
  "pulseaudio": {
      "format": "{volume}% ",
      "format-bluetooth": "{volume}% 󰂯",
      "format-muted": "Audio Muted 󰟎",
      "on-click": "pavucontrol"
  },
  "pulseaudio/slider": {
      "min": 0,
      "max": 100,
      "orientation": "horizontal"
  },
  "group/lightgroup": {
		"orientation": "horizontal",
    "click-to-reveal": true,
		"modules": [
			"backlight",
			"backlight/slider"
		],
    "drawer": {
      "click-to-reveal": false,
      "transition-duration": 600,
      "transition-left-to-right": true,
      "children-class": "audio_children_class"
    }
	},
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["󱩎", "󱩐", "󱩑", "󱩒","󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"]
  },
  "backlight/slider": {
      "min": 1,
      "max": 100,
      "orientation": "horizontal"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", "", "", ""]
  },
  "custom/power": {
    "format": "  ⏻  ",
    "on-click": "wlogout"
  }

}
